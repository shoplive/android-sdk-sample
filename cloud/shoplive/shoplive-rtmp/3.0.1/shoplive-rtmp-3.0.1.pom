    <license>
      <name>MIT License</name>
      <url>https://github.com/shoplive/android-sdk-sample/blob/develop/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>developer</id>
      <name>Shoplive</name>
      <email>ask@shoplive.cloud</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/shoplive/android-sdk-sample/</url>
  </scm>
