<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cloud.shoplive</groupId>
  <artifactId>shoplive-streamer-sdk</artifactId>
  <version>3.0.1</version>
  <packaging>aar</packaging>
  <name>shoplive-streamer-sdk</name>
  <description>Shoplive Android Streamer</description>
  <url>https://www.shoplive.cloud/</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/shoplive/android-sdk-sample/blob/develop/LICENSE</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>developer</id>
      <name>Shoplive</name>
      <email>ask@shoplive.cloud</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/shoplive/android-sdk-sample/</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>cloud.shoplive</groupId>
      <artifactId>shoplive-core</artifactId>
      <version>3.0.1</version>
    </dependency>
    <dependency>
      <groupId>cloud.shoplive</groupId>
      <artifactId>shoplive-webrtc</artifactId>
      <version>3.0.1</version>
    </dependency>
    <dependency>
      <groupId>cloud.shoplive</groupId>
      <artifactId>shoplive-rtmp</artifactId>
      <version>3.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>1.8.22</version>
    </dependency>
    <dependency>
      <groupId>androidx.annotation</groupId>
      <artifactId>annotation</artifactId>
      <version>1.7.1</version>
    </dependency>
  </dependencies>
</project>
